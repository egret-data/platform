# Postgres (matches docker-compose.dev.yml)
DATABASE_URL=postgres://egret:egret@localhost:5432/egret
EGRET_DATABASE__URL=postgres://egret:egret@localhost:5432/egret

# Server
EGRET_SERVER__HOST=0.0.0.0
EGRET_SERVER__PORT=8080

# Logging
EGRET_LOG__FILTER=info,egret=debug
EGRET_LOG__JSON=false

# RustFS (object storage — used from Phase 2)
AWS_ACCESS_KEY_ID=egret
AWS_SECRET_ACCESS_KEY=egretsecret
AWS_ENDPOINT_URL=http://localhost:9000

# Object store used by the apps/workflow/catalog features (required: Config::validate fails without them).
# The bucket must exist: `just up` does not create it; `just demo-up` does.
EGRET_STORAGE__ENDPOINT=http://localhost:9000
EGRET_STORAGE__BUCKET=warehouse
EGRET_STORAGE__ACCESS_KEY=egret
EGRET_STORAGE__SECRET_KEY=egretsecret
EGRET_STORAGE__REGION=us-east-1
EGRET_STORAGE__PATH_STYLE=true
# Public development value, NOT a secret. Never reuse it outside local development.
EGRET_SECRETS__MASTER_KEY=q1IaZ2X7N3i/um/U/aJ2lsmVrRE5pTZChAVG9ezDKPw=

# OIDC / SSO (local Keycloak — see deploy/docker-compose.dev.yml). SSO is the
# default dev sign-in; the local admin below stays as a break-glass login.
EGRET_OIDC__ENABLED=true
EGRET_OIDC__ISSUER_URL=http://localhost:8081/realms/egret
EGRET_OIDC__CLIENT_ID=egret
EGRET_OIDC__CLIENT_SECRET=egret-secret
# Must return to the Vite origin (:5173) so the session cookie lands on the app.
EGRET_OIDC__REDIRECT_URL=http://localhost:5173/api/auth/oidc/callback
EGRET_OIDC__GROUPS_CLAIM=groups
# Dev-only key for encrypting the OIDC state cookie (base64, >=64 bytes). NOT a secret —
# this value is public. For any non-dev deployment generate a fresh one:
#   head -c 64 /dev/urandom | base64
EGRET_SECURITY__SECRET_KEY=Vi2XPRkbfyTLbSzhWv0VBYeOozGGoUnVSL3pIx2Oy1kbBphJyL0CXpomCNKdrYndzYnOX8MH0oaxhcY6Bt/x8g==

# Workflow http tasks (io.kestra.plugin.core.http.Request / Download / SseRequest).
# Every address a host resolves to must be public, and every redirect hop is
# checked again, unless the host is listed here. Exact, case-insensitive host
# names or IP literals (an IPv6 one with or without brackets): no scheme, port,
# path or wildcard. A listed name is trusted whatever it resolves to. Default
# empty (public addresses only).
# EGRET_WORKFLOW__HTTP__ALLOW_HOSTS='["erp.internal","10.0.0.7"]'
# Download cap in bytes (the smaller of this and [workflow.storage] caps applies). Default 1 GiB.
# EGRET_WORKFLOW__HTTP__MAX_DOWNLOAD_BYTES=1073741824
# SseRequest stops after this many events and succeeds with them. Default 10000.
# EGRET_WORKFLOW__HTTP__MAX_SSE_EVENTS=10000
# Redirect hops followed (0 = any redirect fails). Default 10.
# EGRET_WORKFLOW__HTTP__MAX_REDIRECTS=10
# Connect timeout in seconds when a task sets no options.timeout.connectTimeout. Default 10.
# EGRET_WORKFLOW__HTTP__CONNECT_TIMEOUT_SECS=10
