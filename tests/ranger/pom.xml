<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>egret</groupId><artifactId>ranger-enforcement-test</artifactId><version>1.0</version>
  <properties><maven.compiler.release>11</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><ranger.version>2.5.0</ranger.version></properties>
  <dependencies>
    <dependency><groupId>org.apache.ranger</groupId><artifactId>ranger-plugins-common</artifactId><version>${ranger.version}</version></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Surefire's default includes are Test*, *Test, *Tests, *TestCase, none
               of which matches EgretCaseRunner. Named explicitly rather than
               renaming the class, so the differential runner keeps a name that
               says what it is and cannot be mistaken for the four hand-written
               anchor tests it must stay separate from. -->
          <includes>
            <include>EgretRangerEnforcementTest.java</include>
            <include>EgretCaseRunner.java</include>
            <!-- SP4d-2b Task 2: measures the trie/matcher agreement table from
                 the real jar, so the Rust side's hard-coded copy of it has an
                 independent counterpart instead of asserting against itself. -->
            <include>EgretTagTrieAgreementTest.java</include>
            <!-- SP4d-2b Task 3 fix round 2: measures which RESOURCE policies
                 getLikelyMatchPolicyEvaluators returns, which offset 553 made
                 outcome-relevant for the first time. -->
            <include>EgretResourceTrieCandidacyTest.java</include>
            <!-- SP4d-2b Task 4: measures which tag service resources
                 RangerTagEnricher KEEPS, by running the real
                 createRangerServiceResourceMatcher. The Rust side's
                 `service_resource_validates` reproduces this table. -->
            <include>EgretTagServiceResourceValidationTest.java</include>
            <!-- SP4d-2b Task 7 fix round 1: measures the MatchType the enricher's
                 matcher produces for one STORED assignment row, including the
                 wildcard and differing-case rows whose absence from the resolver's
                 predicate was the round's Critical. ⚠ This list is an allow-list,
                 not a pattern: a new *Test.java that is not named here COMPILES AND
                 NEVER RUNS, and the suite stays green — which is how this entry came
                 to be added one run late. -->
            <include>EgretTagAttachmentMatchTypeTest.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
