{
  "name": "egret-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bundle": "node scripts/assert-label-layout-bundled.mjs",
    "test:bundle:xlsx": "node scripts/assert-xlsx-lazy.mjs",
    "test:bundle:csp": "node scripts/assert-csp-allows-entry.mjs",
    "test:bundle:monaco": "node scripts/assert-monaco-lazy.mjs",
    "test:bundle:workflows": "node scripts/assert-workflows-lazy.mjs",
    "test:bundle:governance-data": "node scripts/assert-governance-data-lazy.mjs",
    "test:bundle:governance-people": "node scripts/assert-governance-people-lazy.mjs",
    "test:bundle:governance-overview": "node scripts/assert-governance-overview-lazy.mjs",
    "gen:api": "orval && node scripts/encode-path-params.mjs && node scripts/write-api-digest.mjs",
    "lint": "eslint . && node scripts/lint-legacy.mjs",
    "lint:legacy": "node scripts/lint-legacy.mjs",
    "lint:harness": "cd .. && frontend/node_modules/.bin/eslint --config frontend/eslint.config.js scripts/harness",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.13",
    "echarts": "^6.1.0",
    "lucide-react": "^1.31.0",
    "monaco-editor": "0.56.0",
    "monaco-yaml": "5.5.1",
    "plotly.js-dist-min": "^3.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "sql-formatter": "^15.8.2",
    "tailwind-merge": "^3.4.0",
    "write-excel-file": "^4.1.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "orval": "^8.24.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
