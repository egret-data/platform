[
  {"id": "coalesce-null",         "expr": "{{ missing ?? 'fallback' }}",         "context": {"missing": null}},
  {"id": "coalesce-present",      "expr": "{{ present ?? 'fallback' }}",         "context": {"present": "x"}},
  {"id": "coalesce-absent",       "expr": "{{ nothere ?? 'fallback' }}",         "context": {}},
  {"id": "undef-coalesce-null",   "expr": "{{ missing ??? 'fallback' }}",        "context": {"missing": null}},
  {"id": "undef-coalesce-absent", "expr": "{{ nothere ??? 'fallback' }}",        "context": {}},
  {"id": "ternary",               "expr": "{{ flag ? 'yes' : 'no' }}",           "context": {"flag": true}},
  {"id": "isin",                  "expr": "{{ 'b' isIn ['a','b'] }}",            "context": {}},
  {"id": "gt-strings",            "expr": "{{ 'b' > 'a' }}",                     "context": {}},
  {"id": "gt-numbers",            "expr": "{{ 2 > 10 }}",                        "context": {}},
  {"id": "gt-mixed",              "expr": "{{ '2' > 10 }}",                      "context": {}},
  {"id": "op-inside-string",      "expr": "{{ 'a ?? b' }}",                      "context": {}},
  {"id": "nested-ternary",        "expr": "{{ a ? (b ? 'x' : 'y') : 'z' }}",     "context": {"a": true, "b": false}},

  {"id": "filter-chunk",              "expr": "{{ list | chunk(size=2) }}",                              "context": {"list": [1, 2, 3, 4, 5]}},
  {"id": "filter-classname",          "expr": "{{ list | className }}",                                  "context": {"list": [1, 2, 3]}},
  {"id": "filter-date",               "expr": "{{ d | date('yyyy-MM-dd', timeZone='UTC') }}",           "context": {"d": "2024-01-15T10:30:00Z"}},
  {"id": "filter-dateadd",            "expr": "{{ d | dateAdd(1, 'DAYS', 'iso', 'UTC') }}",              "context": {"d": "2024-01-15T10:30:00Z"}},
  {"id": "filter-timestamp",          "expr": "{{ d | timestamp }}",                                     "context": {"d": "2024-01-15T10:30:00Z"}},
  {"id": "filter-timestampmicro",     "expr": "{{ d | timestampMicro }}",                                "context": {"d": "2024-01-15T10:30:00Z"}},
  {"id": "filter-timestampmilli",     "expr": "{{ d | timestampMilli }}",                                "context": {"d": "2024-01-15T10:30:00Z"}},
  {"id": "filter-timestampnano",      "expr": "{{ d | timestampNano }}",                                 "context": {"d": "2024-01-15T10:30:00Z"}},
  {"id": "filter-jq",                 "expr": "{{ json | jq('.a.b') }}",                                 "context": {"json": {"a": {"b": 42}}}},
  {"id": "filter-escapechar",         "expr": "{{ s | escapeChar(type='single') }}",                     "context": {"s": "it's"}},
  {"id": "filter-tojson",             "expr": "{{ obj | toJson }}",                                      "context": {"obj": {"a": 1, "b": [1, 2]}}},
  {"id": "filter-distinct",           "expr": "{{ list | distinct }}",                                   "context": {"list": [1, 1, 2, 3, 3]}},
  {"id": "filter-keys",               "expr": "{{ obj | keys }}",                                        "context": {"obj": {"a": 1, "b": 2}}},
  {"id": "filter-number",             "expr": "{{ s | number(type='INT') }}",                            "context": {"s": "42"}},
  {"id": "filter-urldecode",          "expr": "{{ s | urldecode }}",                                     "context": {"s": "hello%20world"}},
  {"id": "filter-slugify",            "expr": "{{ s | slugify }}",                                       "context": {"s": "Hello World!"}},
  {"id": "filter-substringbefore",    "expr": "{{ s | substringBefore(separator='-') }}",                "context": {"s": "a-b-c"}},
  {"id": "filter-substringbeforelast","expr": "{{ s | substringBeforeLast(separator='-') }}",            "context": {"s": "a-b-c"}},
  {"id": "filter-substringafter",     "expr": "{{ s | substringAfter(separator='-') }}",                 "context": {"s": "a-b-c"}},
  {"id": "filter-substringafterlast", "expr": "{{ s | substringAfterLast(separator='-') }}",             "context": {"s": "a-b-c"}},
  {"id": "filter-flatten",            "expr": "{{ list | flatten }}",                                    "context": {"list": [[1, 2], [3], [4, 5]]}},
  {"id": "filter-indent",             "expr": "{{ s | indent(amount=2) }}",                              "context": {"s": "line1\nline2"}},
  {"id": "filter-nindent",            "expr": "{{ s | nindent(amount=2) }}",                             "context": {"s": "line1\nline2"}},
  {"id": "filter-yaml",               "expr": "{{ obj | yaml }}",                                        "context": {"obj": {"a": 1, "b": [1, 2]}}},
  {"id": "filter-startswith",         "expr": "{{ s | startsWith(value='hel') }}",                       "context": {"s": "hello"}},
  {"id": "filter-endswith",           "expr": "{{ s | endsWith(value='llo') }}",                         "context": {"s": "hello"}},
  {"id": "filter-values",             "expr": "{{ obj | values }}",                                      "context": {"obj": {"a": 1, "b": 2}}},
  {"id": "filter-toion",              "expr": "{{ obj | toIon }}",                                       "context": {"obj": {"a": 1}}},
  {"id": "filter-sha1",               "expr": "{{ s | sha1 }}",                                          "context": {"s": "hello"}},
  {"id": "filter-sha512",             "expr": "{{ s | sha512 }}",                                        "context": {"s": "hello"}},
  {"id": "filter-md5",                "expr": "{{ s | md5 }}",                                           "context": {"s": "hello"}},
  {"id": "filter-string",             "expr": "{{ n | string }}",                                        "context": {"n": 42}},
  {"id": "filter-regexmatch",         "expr": "{{ s | regexMatch(regex='\\d+') }}",                      "context": {"s": "abc123"}},
  {"id": "filter-regexreplace",       "expr": "{{ s | regexReplace(regex='\\d+', replacement='#') }}",  "context": {"s": "abc123def456"}},
  {"id": "filter-regexextract",       "expr": "{{ s | regexExtract(regex='\\d+') }}",                   "context": {"s": "order-12345-done"}},

  {"id": "function-now",              "expr": "{{ now() }}",                                             "context": {}},
  {"id": "function-fromjson",         "expr": "{{ fromJson(json=raw) }}",                                "context": {"raw": "{\"a\": 1, \"b\": [1, 2]}"}},
  {"id": "function-env",              "expr": "{{ env(name='MY_VAR', default='fallback') }}",            "context": {}},
  {"id": "function-secret",           "expr": "{{ secret(key='my-key') }}",                              "context": {}},
  {"id": "function-kv",               "expr": "{{ kv(key='my-key') }}",                                  "context": {}},
  {"id": "function-read",             "expr": "{{ read(path='a/b.txt') }}",                              "context": {}},
  {"id": "function-fileuri",          "expr": "{{ fileURI(path='a/b.txt') }}",                           "context": {}},
  {"id": "function-encrypt",          "expr": "{{ encrypt(key=k, plaintext='hello-secret') }}",          "context": {"k": "vWgkeuVCYm5x3qwIU19oyzGfKFRlzLPlisR3dsVwhvY="}},
  {"id": "function-decrypt",          "expr": "{{ decrypt(key=k, encrypted=e) }}",                       "context": {"k": "vWgkeuVCYm5x3qwIU19oyzGfKFRlzLPlisR3dsVwhvY=", "e": "jw802WCJ41neKSYhoaevC8MOepbp12q0JVqoduhDIfo0Gv7nMnr2uA=="}},
  {"id": "function-yaml",             "expr": "{{ yaml(yaml=y) }}",                                      "context": {"y": "a: 1\nb: 2\n"}},
  {"id": "function-fetchcontext",     "expr": "{{ fetchContext() }}",                                    "context": {"x": 1}},
  {"id": "function-printcontext",     "expr": "{{ printContext() }}",                                    "context": {"x": 1}},
  {"id": "function-uuid",             "expr": "{{ uuid() }}",                                            "context": {}},
  {"id": "function-id",               "expr": "{{ id() }}",                                              "context": {}},
  {"id": "function-ksuid",            "expr": "{{ ksuid() }}",                                           "context": {}},
  {"id": "function-fromion",          "expr": "{{ fromIon(ion=i) }}",                                    "context": {"i": "{a:1,b:2}"}},
  {"id": "function-filesize",         "expr": "{{ fileSize(path='a/b.txt') }}",                          "context": {}},
  {"id": "function-randomint",        "expr": "{{ randomInt(lower=1, upper=10) }}",                      "context": {}},
  {"id": "function-randomport",       "expr": "{{ randomPort() }}",                                      "context": {}},
  {"id": "function-fileexists",       "expr": "{{ fileExists(path='a/b.txt') }}",                        "context": {}},
  {"id": "function-isfileempty",      "expr": "{{ isFileEmpty(path='a/b.txt') }}",                       "context": {}},
  {"id": "function-nanoid",           "expr": "{{ nanoId() }}",                                          "context": {}},
  {"id": "function-taskswithstate",   "expr": "{{ tasksWithState(state='FAILED') }}",                    "context": {"tasks": {"myTask": {"state": "FAILED"}}}},
  {"id": "function-http",             "expr": "{{ http(uri='https://example.com') }}",                   "context": {}},
  {"id": "function-range",            "expr": "{{ range(start=1, end=5) }}",                             "context": {}},
  {"id": "function-ispublicholiday",  "expr": "{{ isPublicHoliday(date=d, countryCode='FR') }}",         "context": {"d": "2024-01-01"}},
  {"id": "function-isdayweekinmonth", "expr": "{{ isDayWeekInMonth(date=d, dayOfWeek='MONDAY', position='FIRST') }}", "context": {"d": "2024-01-01"}},
  {"id": "function-isweekend",        "expr": "{{ isWeekend(date=d) }}",                                 "context": {"d": "2024-01-06"}},
  {"id": "function-islastworkingday", "expr": "{{ isLastWorkingDay(date=d) }}",                          "context": {"d": "2024-01-31"}},
  {"id": "function-dayofweek",        "expr": "{{ dayOfWeek(date=d) }}",                                 "context": {"d": "2024-01-06"}},
  {"id": "function-hourofday",        "expr": "{{ hourOfDay(date=d) }}",                                 "context": {"d": "2024-01-06T14:30:00Z"}},
  {"id": "function-dayofmonth",       "expr": "{{ dayOfMonth(date=d) }}",                                "context": {"d": "2024-01-06"}},
  {"id": "function-monthofyear",      "expr": "{{ monthOfYear(date=d) }}",                               "context": {"d": "2024-01-06"}},
  {"id": "function-loopoutputs",      "expr": "{{ loopOutputs(outputs=o, name='x') }}",                  "context": {"o": [{"outputs": {"x": 1}}, {"outputs": {"x": 2}}]}},

  {"id": "test-json-true",  "expr": "{{ (s is json) }}",  "context": {"s": "{\"a\": 1}"}},
  {"id": "test-json-false", "expr": "{{ (s is json) }}",  "context": {"s": "not json"}}
]
