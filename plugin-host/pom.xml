<?xml version="1.0" encoding="UTF-8"?>
<!--
  egret's Kestra plugin host (W5b, spec docs/en/specs/2026-09-29-workflow-w5b-kestra-plugin-host-design.md §3).

  One JVM per task-run attempt: `EgretPluginHost run task.json` deserializes one real,
  unmodified Kestra plugin task and runs it against `ShimRunContext`, with no Micronaut.
  `EgretPluginHost describe <plugins-dir>` prints the catalog egret embeds.

  The Kestra core is the same artifact the Pebble oracle links (crates/egret-workflow/oracle/pom.xml),
  pinned by programme spec §7 rule 1. The plugin jars are NOT Maven dependencies (they are fat jars,
  and their base `plugin-jdbc` is not on Central): `fetch-plugins.sh` downloads them, checked against
  `plugins.lock`, into a directory that goes on the classpath beside `target/lib/`.

  The tests need those jars too (surefire puts `target/plugins/*.jar` on their classpath), so on a
  fresh checkout run `plugin-host/fetch-plugins.sh plugin-host/target/plugins` BEFORE
  `mvn -f plugin-host/pom.xml verify`, or `just test-plugin-host`, which does both. Without them the
  tests that load a plugin fail. (2026-10-08, W9c Task 8: recorded after Task 7's review, I-1.)

  Requires JDK 25: Kestra 2.x class files are version 69.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.egret</groupId>
  <artifactId>egret-plugin-host</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <kestra.version>2.0.0-rc13</kestra.version>
    <junit.version>5.10.3</junit.version>
    <!-- Where the tests find the three plugin jars (fetch-plugins.sh target/plugins). -->
    <plugins.dir>${project.build.directory}/plugins</plugins.dir>
  </properties>

  <!-- Netty arrives transitively with io.kestra:core (4.2.16.Final with rc13). netty-handler
       4.2.16 has CVE-2026-75595 (CRITICAL, fixed in 4.2.17), so every Netty module is overridden to
       one 4.2.17.Final through Netty's BOM, keeping the modules on a single version. Drop this
       once the Kestra version brings 4.2.17 or later itself. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>4.2.17.Final</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.kestra</groupId>
      <artifactId>core</artifactId>
      <version>${kestra.version}</version>
    </dependency>

    <!-- Bean validation without Micronaut's context: io.kestra:core already resolves this
         exact version (runtime scope, through micronaut-hibernate-validator); compile scope
         here only because ShimRunContext names ParameterMessageInterpolator. No new jar. -->
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <version>8.0.2.Final</version>
    </dependency>

    <!-- W5b fix round 1 (I1): MaskingLayout extends logback's PatternLayout. io.kestra:core already
         resolves this exact version (runtime scope); compile scope here only because the host names
         the class. No new jar. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>1.5.37</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>egret-plugin-host</finalName>
    <!-- The tests read the committed catalog as the classpath resource `catalog.json`, the same
         name the image gives the one it generates (deploy/docker/plugin-host.Dockerfile). -->
    <testResources>
      <testResource>
        <directory>${project.basedir}/../crates/egret-workflow/src/plugins</directory>
        <includes>
          <include>catalog.json</include>
        </includes>
      </testResource>
      <!-- W9a Task 9: base-uri-cases.json, written by the Rust test
           `kestra::tests::the_base_uri_fixture_is_what_egret_computes`. -->
      <testResource>
        <directory>${project.basedir}/src/test/resources</directory>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <additionalClasspathElements>
            <additionalClasspathElement>${plugins.dir}/plugin-jdbc-postgres-2.0.0.jar</additionalClasspathElement>
            <additionalClasspathElement>${plugins.dir}/plugin-jdbc-trino-2.0.0.jar</additionalClasspathElement>
            <additionalClasspathElement>${plugins.dir}/plugin-jdbc-mysql-2.0.0.jar</additionalClasspathElement>
          </additionalClasspathElements>
          <systemPropertyVariables>
            <egret.plugins.dir>${plugins.dir}</egret.plugins.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- The image's classpath is target/lib/* (Kestra core and its dependencies) + the host jar
           + the three plugin jars; no fat jar, so the jars stay byte-identical to Central's. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
