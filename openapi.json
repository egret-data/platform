                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Ack": {
        "type": "object",
        "description": "The uniform acknowledgement body `{ \"ok\": true }` returned by mutating\nendpoints that have nothing else to say (delete, cancel, …).",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "ColumnMeta": {
        "type": "object",
        "description": "One column's name + engine-reported type name.",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "ConnOptions": {
        "type": "object",
        "description": "Non-secret connection options stored in `databases.options` (jsonb).",
        "properties": {
          "user": {
            "type": [
              "string",
              "null"
            ]
          },
          "http_scheme": {
            "type": [
              "string",
              "null"
            ],
            "description": "Trino only: \"http\" | \"https\"."
          },
          "catalog": {
            "type": [
              "string",
              "null"
            ],
            "description": "Trino default catalog (optional)."
          },
          "database": {
            "type": [
              "string",
              "null"
            ],
            "description": "StarRocks default database (optional)."
          },
          "impersonate": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Trino only: run each query as the logged-in user (X-Trino-User).\nRequires Trino impersonation + Ranger. Default false."
          }
        }
      },
      "Database": {
        "type": "object",
        "description": "A full database registration row (no secret material).\n\n`Serialize`/`Deserialize` are forward-looking contract surface: today the\nwire type is the separate `DatabaseDetailDto` and the store builds `Database`\nfield-by-field from sqlx rows, so these codecs are not yet exercised — they\nlet a future out-of-process query-seam client exchange this domain type.",
        "required": [
          "id",
          "name",
          "engine",
          "host",
          "port",
          "options",
          "has_secret",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "engine": {
            "$ref": "#/components/schemas/Engine"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "format": "int32"
          },
          "options": {
            "$ref": "#/components/schemas/ConnOptions"
          },
          "has_secret": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "DatabaseDetailDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "engine",
          "host",
          "port",
          "options",
          "has_secret",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "engine": {
            "$ref": "#/components/schemas/Engine"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "format": "int32"
          },
          "options": {
            "$ref": "#/components/schemas/ConnOptions"
          },
          "has_secret": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "DatabaseInput": {
        "type": "object",
        "description": "Register/update body. Credentials are a NAMED secret (Epic B): either\n`new_secret` (mint a new named secret inline) or `secret_id` (reference an\nexisting named secret in the workspace). Omitting both registers a connection\nwith no secret (or, on update, keeps the existing one).",
        "required": [
          "name",
          "engine",
          "host",
          "port"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "engine": {
            "$ref": "#/components/schemas/Engine"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "format": "int32"
          },
          "options": {
            "$ref": "#/components/schemas/ConnOptions"
          },
          "secret_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "new_secret": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/NewSecret"
              }
            ]
          }
        }
      },
      "DatabaseListDto": {
        "type": "object",
        "description": "Minimal listing for the Explorer DB picker (no connection internals).",
        "required": [
          "id",
          "name",
          "engine"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "engine": {
            "$ref": "#/components/schemas/Engine"
          }
        }
      },
      "Engine": {
        "type": "string",
        "description": "Supported query engines.",
        "enum": [
          "trino",
          "starrocks"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "description": "The JSON body every error response carries: `{ \"error\": \"<message>\" }`.\n\nThis is the OpenAPI schema counterpart of the body produced by\n`IntoResponse for Error` above — the single shape returned for every 4xx/5xx\nacross the API. Handlers reference it in their `#[utoipa::path]`\n`responses(...)` for the error statuses. 5xx messages are redacted to\n`\"internal error\"`; client-facing errors pass their `Display` message.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Public-safe error message.",
            "example": "not found: user"
          }
        }
      },
      "NewSecret": {
        "type": "object",
        "description": "Request shape for creating a brand-new named secret inline while registering a\nconnection (storage or database): `{ \"name\": ..., \"value\": ... }`. The value\nis plaintext, accepted only on write and never returned. Shared across the\nHTTP layers so each connection type can mint a named secret in one request.",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string",
            "description": "Plaintext secret value; accepted only on write, never returned."
          }
        }
      },
      "QueryListItem": {
        "type": "object",
        "description": "History list item (no result bodies).",
        "required": [
          "id",
          "database_id",
          "status",
          "sql",
          "submitted_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "database_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/QueryStatus"
          },
          "sql": {
            "type": "string"
          },
          "row_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "QueryStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "finished",
          "failed",
          "cancelled"
        ]
      },
      "QueryStatusDto": {
        "type": "object",
        "description": "Full status view (preview inline; full result via the results endpoint).",
        "required": [
          "id",
          "database_id",
          "status",
          "truncated"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "database_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/QueryStatus"
          },
          "columns": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ColumnMeta"
            },
            "description": "Column metadata `[{name,type}]`; `null` until the query finishes."
          },
          "preview": {
            "type": [
              "object",
              "null"
            ],
            "description": "Inline preview rows (bounded, row-major); `null` until the query finishes."
          },
          "row_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "bytes_scanned": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "truncated": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ResultsPage": {
        "type": "object",
        "description": "A page of the full result.",
        "required": [
          "columns",
          "rows",
          "page",
          "page_size",
          "row_count",
          "truncated"
        ],
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnMeta"
            },
            "description": "Column metadata `[{name,type}]`."
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Row-major cell values; each element is one row (a JSON array)."
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "page_size": {
            "type": "integer",
            "minimum": 0
          },
          "row_count": {
            "type": "integer",
            "format": "int64"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "SubmitAck": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/QueryStatus"
          }
        }
      },
      "SubmitQuery": {
        "type": "object",
        "required": [
          "database_id",
          "sql"
        ],
        "properties": {
          "database_id": {
            "type": "string",
            "format": "uuid"
          },
          "sql": {
            "type": "string"
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "TabularResult": {
        "type": "object",
        "description": "A fully-collected, in-memory query result (bounded by the caller's row limit).\n\n`Serialize`/`Deserialize` are for the E4b contract crate + BI forwarding this\nresult directly across the seam boundary; today the store persists `columns`\nand `rows` individually, so the whole-struct codecs are not yet exercised.",
        "required": [
          "columns",
          "rows",
          "row_count",
          "truncated"
        ],
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnMeta"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "description": "Row-major cell values; each inner vec is one row aligned to `columns`."
          },
          "row_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "bytes_scanned": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "TestInput": {
        "type": "object",
        "description": "Body for testing an unsaved connection (no `name`).",
        "required": [
          "engine",
          "host",
          "port"
        ],
        "properties": {
          "engine": {
            "$ref": "#/components/schemas/Engine"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "format": "int32"
          },
          "options": {
            "$ref": "#/components/schemas/ConnOptions"
          },
          "secret": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "TestOutcome": {
        "type": "object",
        "description": "Result of a connection test.",
        "required": [
          "ok",
          "latency_ms",
          "detail"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "latency_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "databases",
      "description": "Workspace database registry (engines + connection secrets)"
    },
    {
      "name": "queries",
      "description": "Workspace query submission, status, results, and history"
    }
  ]
}
